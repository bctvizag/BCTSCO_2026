{
  "name": "sql-backend-api",
  "version": "1.0.0",
  "description": "Node.js REST API with Sequelize ORM and MS SQL Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "esbuild server.js --bundle --platform=node --target=node18 --outfile=dist/server.js --external:sequelize --external:tedious",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "sequelize": "^6.35.2",
    "tedious": "^16.7.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "nodemon": "^3.0.2"
  }
}
